{
  "name": "jyotirmoy",
  "version": "0.1.0",
  "description": "A simple CLI wrapper for adding components from jyotimoydas.in component registry using shadcn.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start:dev": "node dist/index.js",
    "publish:release": "bun run build && bun publish --access public",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "jyotirmoy",
    "jyotimoydas",
    "cli",
    "shadcn",
    "components",
    "registry"
  ],
  "author": "Jyotirmoy Das <jyotimoydas12345@gmail.com>",
  "license": "MIT",
  "homepage": "https://jyotimoydas.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JyotirmoyDas05/portfolio.git",
    "directory": "packages/jyotirmoy"
  },
  "funding": "https://github.com/sponsors/JyotirmoyDas05",
  "bugs": {
    "url": "https://github.com/JyotirmoyDas05/portfolio/issues"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  },
  "packageManager": "bun@1.2.4"
}
