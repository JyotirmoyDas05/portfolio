    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JyotirmoyDas05/portfolio.git"
  },
  "scripts": {
    "generate:badge-cache": "bun run ./src/scripts/generate-badge-cache.mts",
    "generate:blur": "bun run ./scripts/generate-blur-placeholders.ts",
    "predev": "bun run generate:badge-cache",
    "dev": "next dev -p 1408 --webpack",
    "prebuild": "bun run generate:badge-cache && bun run generate:blur",
    "build": "next build --webpack",
    "start": "next start",
    "preview": "next build --webpack && next start -p 1408",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "check-types": "tsc --noEmit --pretty",
    "format:check": "prettier --check \"**/*.{ts,tsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,mdx}\" --cache",
    "registry:internal:build": "tsx --tsconfig ./tsconfig.scripts.json ./src/scripts/build-registry.mts",
    "registry:build": "bun run registry:internal:build && shadcn build ./src/__registry__/registry.autogenerated.json",
    "capture": "tsx --tsconfig ./tsconfig.scripts.json ./src/scripts/capture.mts",
    "generate-libphonenumber-metadata": "libphonenumber-metadata-generator ./src/assets/libphonenumber.metadata.json --countries VN --extended",
    "upgrade:next": "bunx @next/codemod@latest upgrade latest",
    "upgrade:tailwind": "bunx @tailwindcss/upgrade@latest",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@bprogress/next": "^3.2.12",
    "@c15t/nextjs": "^1.8.1",
    "@date-fns/tz": "^1.4.1",
    "@hookform/resolvers": "^4.1.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "fumadocs-core": "^16.0.0",
    "geist": "^1.5.1",
    "gsap": "^3.14.2",
    "jotai": "^2.12.5",
    "katex": "^0.16.27",
    "libphonenumber-js": "^1.12.4",
    "lucide-react": "^0.544.0",
    "motion": "^12.18.1",
    "next": "16.1.0",
    "next-mdx-remote": "^5.0.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.0",
    "plaiceholder": "^3.0.0",
    "posthog-js": "^1.310.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-fast-marquee": "^1.6.5",
    "react-hook-form": "^7.54.2",
    "react-hotkeys-hook": "^5.2.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-medium-image-zoom": "^5.4.0",
    "react-use": "^17.6.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "schema-dts": "^1.1.5",
    "sharp": "^0.34.5",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.1",
    "vcard-creator": "^0.7.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.16",
    "@toolwind/corner-shape": "0.0.8-3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^20.14.12",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.22.0",
    "eslint-config-next": "16.1.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "libphonenumber-metadata-generator": "^1.1.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "puppeteer-core": "^24.10.1",
    "rehype-external-links": "^3.0.0",
    "rehype-pretty-code": "^0.14.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.0",
    "rimraf": "^6.0.1",
    "shadcn": "3.5.0",
    "shiki": "1.9.1",
    "strip-indent": "^4.0.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.8.3",
    "unist-builder": "3.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "resolutions": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "bun@1.2.4"
}
