{
  "name": "portfolio",
  "version": "0.1.0",
  "description": "A minimal, pixel-perfect dev portfolio, component registry, and blog.",
  "homepage": "https://jyotimoydas.in",
  "license": "MIT",
  "author": {
    "name": "Jyotirmoy Das",
    "email": "contact@jyotimoydas.in",
    "url": "https://github.com/JyotirmoyDas05"
  },
  "contributors": [
    {
      "name": "Jyotirmoy Das",
      "email": "contact@jyotimoydas.in",
      "url": "https://github.com/JyotirmoyDas05"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JyotirmoyDas05/portfolio.git"
  },
  "scripts": {
    "generate:badge-cache": "bun run ./src/scripts/generate-badge-cache.mts",
    "generate:blur": "bun run ./scripts/generate-blur-placeholders.ts",
    "predev": "bun run generate:badge-cache",
    "dev": "next dev -p 1408 --webpack",
    "prebuild": "bun run generate:badge-cache && bun run generate:blur",
    "build": "next build --webpack",
    "start": "next start",
    "preview": "next build --webpack && next start -p 1408",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "check-types": "tsc --noEmit --pretty",
    "format:check": "biome check .",
    "format:write": "biome check --write .",
    "format:ci": "biome ci .",
    "registry:internal:build": "tsx --tsconfig ./tsconfig.scripts.json ./src/scripts/build-registry.mts",
    "registry:build": "bun run registry:internal:build && shadcn build ./src/__registry__/registry.autogenerated.json",
    "capture": "tsx --tsconfig ./tsconfig.scripts.json ./src/scripts/capture.mts",
    "generate-libphonenumber-metadata": "libphonenumber-metadata-generator ./src/assets/libphonenumber.metadata.json --countries VN --extended",
    "upgrade:next": "bunx @next/codemod@latest upgrade latest",
    "upgrade:tailwind": "bunx @tailwindcss/upgrade@latest",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@bprogress/next": "^3.2.12",
    "@c15t/nextjs": "1.8.3",
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^5.4.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "fumadocs-core": "^16.11.1",
    "geist": "^1.7.2",
    "gsap": "^3.15.0",
    "jotai": "^2.20.1",
    "katex": "^0.17.0",
    "libphonenumber-js": "^1.13.8",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.9.0",
    "plaiceholder": "^3.0.0",
    "posthog-js": "^1.399.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-fast-marquee": "^1.6.5",
    "react-hook-form": "^7.81.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-medium-image-zoom": "^5.4.8",
    "react-use": "^17.6.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "schema-dts": "^2.0.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vcard-creator": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@toolwind/corner-shape": "0.0.8-3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.10",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "libphonenumber-metadata-generator": "^2.0.6",
    "lint-staged": "^17.0.8",
    "puppeteer-core": "^25.3.0",
    "rehype-external-links": "^3.0.0",
    "rehype-pretty-code": "^0.14.4",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "rimraf": "^6.1.3",
    "shadcn": "4.13.0",
    "shiki": "4.3.1",
    "strip-indent": "^4.1.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.8.3",
    "unist-builder": "4.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "resolutions": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "bun@1.3.14"
}
